# Supabase (Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — usada apenas no servidor (rotas /api/ai/*). Nunca exponha no cliente.
OPENAI_API_KEY=
# Modelo usado pela assistente clínica. Confira os modelos disponíveis na documentação da OpenAI.
OPENAI_MODEL=gpt-4o-mini

# Sem as variáveis do Supabase o app roda em "modo demonstração" (dados locais no navegador).

# Fonte Neulis (títulos) — escolha uma opção, veja o README
NEXT_PUBLIC_ADOBE_FONTS_KIT=
NEXT_PUBLIC_NEULIS_SELF_HOSTED=

# Instagram (métricas) — API oficial da Meta, conta Profissional. Fica só no servidor.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Opcionais — confira versão e nomes de métricas na documentação atual da Meta
INSTAGRAM_GRAPH_BASE=https://graph.facebook.com/v21.0
INSTAGRAM_INSIGHT_METRICS=reach,saved,shares,views

# Somente para demonstrações públicas sem login: liberar a IA real (não recomendado)
ALLOW_PUBLIC_AI=

# Modo demonstração (sem login, dados no navegador). Em produção só funciona com esta variável = 1.
# Para uso real deixe vazio e configure o Supabase: o acesso exige login com e-mail confirmado.
NEXT_PUBLIC_DEMO_MODE=

# Cobranças — envio automático APÓS sua aprovação (sem estas variáveis, o envio é assistido: abre WhatsApp/e-mail)
# E-mail via Resend (domínio do remetente verificado no Resend)
RESEND_API_KEY=
EMAIL_FROM=
# WhatsApp Cloud API (Meta) — modelo aprovado com 4 variáveis: responsável, paciente, valor, vencimento
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR
